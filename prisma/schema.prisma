generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  COMPANY
}

enum JobStatus {
  OPEN
  CLOSED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  REMOTE
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  HIRED
  REJECTED
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  passwordHash String?
  image       String?
  role        Role
  companyName String?
  companyLogo String?
  createdAt   DateTime  @default(now())
  jobs        Job[]
  applications Application[]
}

model Job {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  location    String
  type        JobType
  salaryMin   Int?
  salaryMax   Int?
  description String
  status      JobStatus @default(OPEN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  applications Application[]

  @@index([ownerId])
}

model Application {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvUrl       String
  coverLetter String?
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime  @default(now())

  @@unique([jobId, userId])
  @@index([jobId])
}
